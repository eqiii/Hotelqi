[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	ignorecase = true
[remote "origin"]
	url = https://github.com/eqiii/Hotelqi.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "prog"]
	remote = origin
	merge = refs/heads/prog
[branch "main"]
	vscode-merge-base = origin/main
[branch "if"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/if
